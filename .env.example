# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.
# See docs/ARCHITECTURE_AND_DATA.md and docs/SECURITY.md §5 (least-privilege, separated secrets per environment).

# --- Supabase ---
# Server-side only: without the NEXT_PUBLIC_ prefix, Next.js does not copy
# these into the browser bundle. Fine today — every Supabase call runs on the
# server. A future Client Component that needs Supabase directly would need a
# NEXT_PUBLIC_-prefixed copy of the URL and anon key (both safe to expose).
NEXT_SUPABASE_URL=
NEXT_SUPABASE_ANON_KEY=

# Secret — server-side only. NEVER prefix with NEXT_PUBLIC_, never import
# into client components, never log.
SUPABASE_SERVICE_ROLE_KEY=

# Only needed for direct Postgres access (e.g. Supabase CLI db link, migrations
# run outside the CLI's own auth). Never commit; never prefix with NEXT_PUBLIC_.
SUPABASE_DB_PASSWORD=

# Personal access token from supabase.com/dashboard/account/tokens — CLI auth
# only (supabase link / db push), never used by the app at runtime.
SUPABASE_ACCESS_TOKEN=

# --- Transactional email (enquiry notifications) ---
# Fill in once an email provider is chosen in Phase 1.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=

# --- App ---
# Used for absolute URLs (metadata, sitemap, emails). Update per environment.
NEXT_SITE_URL=http://localhost:3000

# --- Error tracking (Sentry, free tier) ---
# Create a free project at sentry.io, then fill these in. Safe to leave blank
# in local dev — Sentry.init no-ops without a DSN (see src/instrumentation.ts).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Only needed in CI/production for source-map upload — a short-lived token
# from sentry.io, never commit.
SENTRY_AUTH_TOKEN=
